rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isWorkspaceMember(workspaceId) {
      return signedIn() && (
        firestore.get(/databases/(default)/documents/workspaces/$(workspaceId)).data.ownerUid == request.auth.uid
        || firestore.exists(/databases/(default)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid))
      );
    }

    match /workspaces/{workspaceId}/assets/{assetId}/{fileName} {
      allow read: if isWorkspaceMember(workspaceId);
      allow create, update: if isWorkspaceMember(workspaceId)
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|gif|webp)');
      allow delete: if isWorkspaceMember(workspaceId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
